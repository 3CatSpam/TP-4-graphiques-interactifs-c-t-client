---
import "../styles/global.css";
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>Astro Basics</title>
  </head>
  <body>
    <header class="site-header">
      <select id="page-navigation" aria-label="Navigation principale">
        <option value="/" selected={Astro.url.pathname === "/"}>1</option>
        <option value="/index_copy" selected={Astro.url.pathname === "/index_copy"}>2</option>
      </select>
    </header>
    <slot />
  </body>
</html>

<script>
  document.querySelector("#page-navigation")?.addEventListener("change", (event) => {
    const value = (event.target as HTMLSelectElement).value;
    location.pathname = value;
  });
</script>